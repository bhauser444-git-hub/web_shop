<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Unsere Produkte</title>
</head>
<body>
    <header>
        <h1>Produktübersicht</h1>
    </header>
    <a href="/shopping_cart">Shopping Cart</a>
    <a href="/">Back to Home</a>
    <ul>
        <!-- Mit EJS loopen wir direkt durch die SQL-Datenbank-Ergebnisse -->
        <% products.forEach(product => { %>
            <li>
                <strong><%= product.product_name %></strong> - 
                <%= product.price %> €
                <button onclick="myCart.addItem('<%= product.product_id%>')">Add to Cart</button>
            </li>
           <% }); %>

    </ul>
    <script src="/shopping_cart.js"></script>
    <script src="/cart_item.js"></script>
</body>
</html>
